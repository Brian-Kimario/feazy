# ─── Feasy Environment Variables ────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
#
# Prefix rules:
#   NEXT_PUBLIC_*  — safe to expose to the browser
#   (no prefix)    — server-only, never in the browser

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Secret key — server-only, never prefix with NEXT_PUBLIC_
# Preferred. SUPABASE_SERVICE_ROLE_KEY is the legacy name, read only as a fallback.
SUPABASE_SECRET_KEY=<your-secret-key>

# Shared secret for POST /api/cron/assignment-queue and /api/cron/job-media-sweep
# (Authorization: Bearer <secret>). The 6-hourly job-media sweep is called by pg_cron, so the same
# value must also be stored in Supabase Vault as 'cron_secret', with the deployed https URL as
# 'app_url' (see supabase/migrations/20261030_016_schedule_job_media_sweep.sql).
CRON_SECRET=<random-long-string>

# ─── App URL ──────────────────────────────────────────────────────────────────
# Used for deep-links inside notification messages.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Currency & Localization ──────────────────────────────────────────────────
NEXT_PUBLIC_CURRENCY_CODE=INR
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
NEXT_PUBLIC_CURRENCY_LOCALE=en-IN

# ─── Payment Provider ─────────────────────────────────────────────────────────
# Razorpay credentials (live payments)
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<your-razorpay-webhook-secret>

# Mock Payments (Development/Staging Only)
# Set to 'true' to use MockProvider instead of Razorpay in non-production environments.
# MockProvider is automatically disabled in production — attempting to enable it will throw an error.
# Use this for testing payment flows without processing real transactions.
MOCK_PAYMENTS=false
# Set to 'true' to simulate payment verification failures in MockProvider.
# Only affects MockProvider; ignored when using live Razorpay.
MOCK_PAYMENT_FAIL=false

# ─── Razorpay WhatsApp Business API (Phase 10 — Notifications) ───────────────
# Obtain from the Razorpay dashboard → WhatsApp Business.
# Register and get Meta template approval before using in production.
# Server-only — never expose these to the browser.
RAZORPAY_WHATSAPP_API_KEY=<your-razorpay-whatsapp-api-key>
RAZORPAY_WHATSAPP_PHONE_ID=<your-whatsapp-phone-number-id>
RAZORPAY_WHATSAPP_BUSINESS_ACCOUNT_ID=<your-waba-id>

# ─── SMS via AWS SNS (Phase 10 — Notifications) ───────────────────────────────
# IAM user must have sns:Publish permission.
# Sender ID must be registered with TRAI DLT before use in India.
# Server-only.
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_SNS_REGION=ap-south-1
# 6-char alpha DLT-registered sender ID. Default: FEASY
SMS_SENDER_ID=FEASY

# ─── Email via SendGrid (Phase 10 — Notifications) ───────────────────────────
# API key must have "Mail Send" scope.
# The FROM address must be a verified sender in your SendGrid account.
# Server-only.
SENDGRID_API_KEY=<your-sendgrid-api-key>
EMAIL_FROM=noreply@feazy.in

# Password shared by the seeded test accounts (Playwright role sign-in tests)
E2E_TEST_PASSWORD=
# Set to 1 to fail the Playwright run when E2E_TEST_PASSWORD is missing instead of skipping.
E2E_REQUIRED=

# Operations queue alert thresholds (all optional; defaults in src/lib/admin/operations-config.ts).
# These only flag cases for admin review. They never cancel or change a booking.
OPS_OFFER_OVERDUE_GRACE_MINUTES=
OPS_NEW_BOOKING_GRACE_MINUTES=
OPS_UNMATCHED_STOP_MINUTES=
OPS_NO_SHOW_MINUTES=
OPS_STALE_ACTIVITY_HOURS=
NOTIFICATION_DISPATCH_ENABLED=false   # set true only when providers are configured

# Set true only once the founder confirms free inspections (copy only; does not change fees)
NEXT_PUBLIC_FREE_INSPECTION=false
